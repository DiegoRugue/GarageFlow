---
title: Topologia AWS Academy do GarageFlow
---
flowchart TB
    Actions["GitHub Actions protegido<br/>workflow de deploy"]
    Terraform["Terraform plan + apply"]

    subgraph AWS["AWS Academy — us-east-1"]
        direction TB
        TerraformSession["Sessão Terraform<br/>com credenciais temporárias"]
        DeploySession["Sessão de deploy<br/>com credenciais temporárias"]
        S3["S3 de estado remoto<br/>privado, criptografado,<br/>versionado e retido"]
        Secrets["AWS Secrets Manager<br/>valores gerados"]
        ECR["Amazon ECR<br/>imagem imutável por SHA"]

        subgraph VPC["VPC 10.42.0.0/16 — sem NAT Gateway"]
            direction TB
            Internet["Internet<br/>somente dados sintéticos"]
            LB["Service LoadBalancer<br/>entrada pública HTTP"]

            subgraph Public["Camada pública em duas zonas de disponibilidade"]
                direction LR
                PublicA["Subnet pública<br/>AZ A"]
                PublicB["Subnet pública<br/>AZ B"]
            end

            NodeGroup["Amazon EKS managed node group<br/>2 × t3.small nas duas subnets<br/>distribuição por AZ não é garantida"]
            Replicas["Deployment GarageFlow<br/>2 réplicas iniciais<br/>posicionamento por AZ não é garantido"]
            K8sSecret["Kubernetes Secret<br/>criado no deploy"]

            subgraph Private["DB subnet group privado em duas zonas"]
                direction LR
                PrivateA["Subnet privada<br/>AZ A"]
                PrivateB["Subnet privada<br/>AZ B"]
            end

            RDS["RDS PostgreSQL 17<br/>Single-AZ, privado, db.t3.micro"]
        end

        SNS["Amazon SNS<br/>notificações de status"]
        Email["Assinatura de e-mail<br/>confirmada manualmente"]
    end

    Actions --> Terraform --> TerraformSession
    Actions --> DeploySession
    TerraformSession -->|"estado remoto"| S3
    TerraformSession -->|"provisiona"| VPC
    DeploySession -->|"build e push"| ECR
    DeploySession -->|"lê valores no deploy"| Secrets
    Secrets --> K8sSecret -->|"consumido pelos pods"| Replicas
    ECR -->|"imagem por commit SHA"| Replicas
    PublicA --> NodeGroup
    PublicB --> NodeGroup
    NodeGroup --> Replicas
    Internet --> LB --> Replicas
    Replicas -->|"TCP 5432 pelo security group"| RDS
    PrivateA --- RDS
    PrivateB --- RDS
    Replicas -->|"publicação assíncrona"| SNS --> Email

    classDef aws fill:#fff7ed,stroke:#c2410c,color:#111827,stroke-width:2px;
    classDef network fill:#eff6ff,stroke:#1d4ed8,color:#111827;
    classDef private fill:#ecfdf5,stroke:#047857,color:#111827;
    class S3,ECR,SNS,Secrets,RDS aws;
    class LB,PublicA,PublicB,NodeGroup,Replicas,K8sSecret network;
    class PrivateA,PrivateB private;
