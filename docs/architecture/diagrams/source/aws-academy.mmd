---
title: Topologia AWS Academy do GarageFlow
---
flowchart TB
    Internet["Internet<br/>tráfego HTTP com dados sintéticos"]
    Email["E-mail confirmado<br/>notificações de status"]
    Pipeline["GitHub Actions protegido<br/>deploy-demo-destroy"]
    Terraform["Terraform<br/>estado remoto bloqueado"]

    subgraph AWS["AWS Academy — us-east-1"]
        S3["S3 de estado Terraform<br/>privado, criptografado, versionado e retido"]
        ECR["Amazon ECR<br/>imagem imutável por SHA"]
        SNS["Amazon SNS<br/>tópico de ordens de serviço"]
        Secrets["AWS Secrets Manager<br/>segredos gerados para o runtime"]

        subgraph VPC["VPC 10.42.0.0/16 — sem NAT Gateway"]
            IGW["Internet Gateway"]
            LB["LoadBalancer do Kubernetes<br/>entrada pública"]

            subgraph AZA["Zona de disponibilidade A"]
                PublicA["Subnet pública A<br/>EKS e balanceador"]
                NodeA["Nó EKS t3.small A"]
                PodA["Pod GarageFlow API A"]
                PrivateA["Subnet privada de banco A<br/>sem IP público"]
            end

            subgraph AZB["Zona de disponibilidade B"]
                PublicB["Subnet pública B<br/>EKS e balanceador"]
                NodeB["Nó EKS t3.small B"]
                PodB["Pod GarageFlow API B"]
                PrivateB["Subnet privada de banco B<br/>sem IP público"]
            end

            EKS["Amazon EKS<br/>control plane gerenciado"]
            RDS["Amazon RDS PostgreSQL 17<br/>Single-AZ, privado, db.t3.micro"]
            NoNat["Controle de custo<br/>nenhum NAT Gateway"]
        end
    end

    Internet --> IGW --> LB
    LB --> PodA
    LB --> PodB
    PublicA --- NodeA --> PodA
    PublicB --- NodeB --> PodB
    EKS --> NodeA
    EKS --> NodeB
    PodA -->|"TCP 5432 pelo security group"| RDS
    PodB -->|"TCP 5432 pelo security group"| RDS
    PrivateA --- RDS
    PrivateB --- RDS
    RDS -.->|"instância em uma AZ; subnet group em duas"| PrivateA
    ECR -->|"pull da imagem"| NodeA
    ECR -->|"pull da imagem"| NodeB
    Secrets -->|"materializa Secret do namespace"| PodA
    Secrets -->|"materializa Secret do namespace"| PodB
    PodA -->|"publicação assíncrona"| SNS
    PodB -->|"publicação assíncrona"| SNS
    SNS --> Email
    Pipeline --> Terraform --> S3
    Pipeline -->|"build e push"| ECR
    Terraform -->|"provisiona recursos"| VPC
    NoNat -.-> PublicA
    NoNat -.-> PublicB

    classDef aws fill:#fff7ed,stroke:#c2410c,color:#111827,stroke-width:2px;
    classDef network fill:#eff6ff,stroke:#1d4ed8,color:#111827;
    classDef private fill:#ecfdf5,stroke:#047857,color:#111827;
    classDef warning fill:#fef2f2,stroke:#b91c1c,color:#111827,stroke-width:2px;
    class S3,ECR,SNS,Secrets,EKS,RDS aws;
    class IGW,LB,PublicA,PublicB,NodeA,NodeB,PodA,PodB network;
    class PrivateA,PrivateB private;
    class NoNat warning;
