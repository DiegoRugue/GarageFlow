---
title: Arquitetura da aplicação GarageFlow
---
flowchart TB
    Host["GarageFlow.Host<br/>única raiz de composição"]

    subgraph Adapters["Anel externo — adaptadores"]
        direction LR
        Api["GarageFlow.Adapters.Api<br/>Minimal APIs, HTTP e políticas"]
        Infrastructure["GarageFlow.Adapters.Infrastructure<br/>EF Core, PostgreSQL, JWT e SNS"]
    end

    subgraph Core["Núcleo — dependências apontam para dentro"]
        direction TB
        Application["GarageFlow.Application<br/>casos de uso, portas e transações"]
        Domain["GarageFlow.Domain<br/>agregados, invariantes e eventos"]
        SharedKernel["GarageFlow.SharedKernel<br/>primitivas genéricas e IUnitOfWork"]
    end

    Host -->|"compõe HTTP"| Api
    Host -->|"compõe persistência"| Infrastructure
    Host -->|"registra casos de uso"| Application
    Host -->|"mapeia exceções"| SharedKernel
    Api -->|"commands e queries"| Application
    Infrastructure -->|"implementa portas"| Application
    Infrastructure -->|"persiste agregados"| Domain
    Infrastructure -->|"implementa IUnitOfWork"| SharedKernel
    Application --> Domain
    Application --> SharedKernel
    Domain --> SharedKernel

    classDef composition fill:#dbeafe,stroke:#1d4ed8,color:#111827,stroke-width:3px;
    classDef adapter fill:#ecfeff,stroke:#0e7490,color:#111827,stroke-width:2px;
    classDef core fill:#fefce8,stroke:#a16207,color:#111827,stroke-width:2px;
    class Host composition;
    class Api,Infrastructure adapter;
    class Application,Domain,SharedKernel core;
