---
title: Ciclo protegido de deploy, demonstração e destroy
---
flowchart LR
    Start["workflow_dispatch<br/>Environment aws-academy protegido"]

    subgraph Deploy["Deploy protegido"]
        direction TB
        Preflight["Preflight fail-closed<br/>credenciais temporárias, região e inputs"]
        Identity["Valida identidade AWS<br/>e estado remoto legível"]
        Terraform["Terraform plan + apply<br/>rede, EKS, RDS, ECR, SNS e secrets"]
        Image["Build da imagem<br/>push imutável no ECR por commit SHA"]
        Metrics["Instala Metrics Server<br/>aguarda API disponível"]
        Config["Aplica Namespace, ConfigMap<br/>e Secret sem exibir valores"]
        Migration["Executa migration Job<br/>e exige condição Complete"]
        Rollout["Rollout Deployment<br/>duas réplicas prontas + Service + HPA"]
        Confirm["Exige assinatura SNS<br/>de e-mail confirmada"]
        Smoke["Smoke da API pública<br/>health, login e status"]
    end

    subgraph Demo["Demonstração controlada"]
        direction TB
        ApiDemo["Postman<br/>dois endpoints de abertura e webhook"]
        Load["k6 com carga limitada<br/>HPA escala de 2 até no máximo 6"]
        Recover["Interrompe carga<br/>HPA retorna a 2 réplicas"]
        Evidence["Captura evidência não sensível<br/>antes da destruição"]
    end

    subgraph Destroy["Destroy protegido"]
        direction TB
        ConfirmDestroy["Confirmação exata DESTROY<br/>e mesmos inputs protegidos"]
        KubeDelete["Remove Service e namespace<br/>Kubernetes libera o LoadBalancer"]
        WaitLb["Verifica ausência do<br/>LoadBalancer do Service"]
        TfDestroy["Terraform destroy<br/>ambiente Academy gerenciado"]
        Verify["Verifica ausência<br/>EKS, RDS, ECR, SNS, VPC e secrets"]
        Retained["S3 de bootstrap retido<br/>estado versionado para limpeza final explícita"]
    end

    Failure["Falha fechada<br/>diagnosticar e executar novamente"]

    Start --> Preflight --> Identity --> Terraform --> Image --> Metrics --> Config --> Migration --> Rollout --> Confirm --> Smoke
    Smoke --> ApiDemo --> Load --> Recover --> Evidence --> ConfirmDestroy
    ConfirmDestroy --> KubeDelete --> WaitLb --> TfDestroy --> Verify --> Retained
    Preflight -.->|"input inválido"| Failure
    Migration -.->|"Job falhou"| Failure
    Rollout -.->|"menos de 2 pods prontos"| Failure
    Confirm -.->|"assinatura pendente"| Failure
    WaitLb -.->|"recurso ainda presente"| Failure
    Verify -.->|"recurso faturável restante"| Failure

    classDef deploy fill:#dbeafe,stroke:#1d4ed8,color:#111827;
    classDef demo fill:#ecfdf5,stroke:#047857,color:#111827;
    classDef destroy fill:#fff7ed,stroke:#c2410c,color:#111827;
    classDef failure fill:#fef2f2,stroke:#b91c1c,color:#111827,stroke-width:2px;
    class Preflight,Identity,Terraform,Image,Metrics,Config,Migration,Rollout,Confirm,Smoke deploy;
    class ApiDemo,Load,Recover,Evidence demo;
    class ConfirmDestroy,KubeDelete,WaitLb,TfDestroy,Verify,Retained destroy;
    class Failure failure;
