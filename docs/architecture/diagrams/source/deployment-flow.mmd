---
title: Ciclo protegido de deploy, demonstração e destroy
---
flowchart TB
    Start["workflow_dispatch APPLY<br/>Environment aws-academy protegido"]

    subgraph Deploy["Deploy protegido"]
        DeployWorkflow["Workflow deploy-aws-academy.yml"]
        Preflight["Preflight fail-closed<br/>inputs, identidade e estado remoto"]
        Terraform["Terraform plan + apply<br/>rede, EKS, RDS, ECR, SNS e secrets"]
        Image["Build + push imutável no ECR<br/>por commit SHA"]
        Runtime["Metrics Server + configuração<br/>migration Job Complete<br/>2 pods + Service + HPA"]
        Smoke["Assinatura SNS confirmada<br/>e smoke da API pública"]
        DeployWorkflow --> Preflight --> Terraform --> Image --> Runtime --> Smoke
    end

    subgraph Demo["Demonstração controlada"]
        ManualDemo["Demonstração manual<br/>entre os dois workflows"]
        ApiDemo["Postman<br/>dois endpoints de abertura e webhook"]
        Load["k6 com carga limitada<br/>HPA escala de 2 até no máximo 6"]
        Recover["Interrompe carga<br/>HPA retorna a 2 réplicas"]
        Evidence["Captura evidência não sensível<br/>antes da destruição"]
        ManualDemo --> ApiDemo --> Load --> Recover --> Evidence
    end

    subgraph Destroy["Destroy protegido"]
        DestroyWorkflow["Workflow destroy-aws-academy.yml"]
        ConfirmDestroy["Confirmação exata DESTROY<br/>e mesmos inputs protegidos"]
        KubeDelete["Remove Service e namespace<br/>Kubernetes libera o LoadBalancer"]
        WaitLb["Verifica ausência do<br/>LoadBalancer do Service"]
        TfDestroy["Terraform destroy<br/>ambiente Academy gerenciado"]
        Verify["Verifica ausência<br/>EKS, RDS, ECR, SNS, VPC e secrets"]
        Retained["S3 de bootstrap retido<br/>limpeza final explícita"]
        DestroyWorkflow --> ConfirmDestroy --> KubeDelete --> WaitLb --> TfDestroy --> Verify --> Retained
    end

    Failure["Qualquer gate falha fechado<br/>diagnosticar e executar novamente"]

    Start --> DeployWorkflow
    Smoke --> ManualDemo
    Evidence --> DestroyWorkflow
    Preflight -.-> Failure
    Runtime -.-> Failure
    WaitLb -.-> Failure
    Verify -.-> Failure

    classDef deploy fill:#dbeafe,stroke:#1d4ed8,color:#111827;
    classDef demo fill:#ecfdf5,stroke:#047857,color:#111827;
    classDef destroy fill:#fff7ed,stroke:#c2410c,color:#111827;
    classDef failure fill:#fef2f2,stroke:#b91c1c,color:#111827,stroke-width:2px;
    class DeployWorkflow,Preflight,Terraform,Image,Runtime,Smoke deploy;
    class ManualDemo,ApiDemo,Load,Recover,Evidence demo;
    class DestroyWorkflow,ConfirmDestroy,KubeDelete,WaitLb,TfDestroy,Verify,Retained destroy;
    class Failure failure;
