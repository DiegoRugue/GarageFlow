---
title: Consistência transacional, inbox e outbox
---
flowchart TB
    subgraph Transactions["TransactionBehavior — escrita atômica PostgreSQL"]
        direction LR
        subgraph Common["Command comum"]
            direction TB
            RegularCommand["Command autenticado"]
            RegularAggregate["Altera WorkOrder<br/>e gera eventos"]
            RegularOutbox["Grava mensagens<br/>de outbox"]
            RegularCommit["Commit atômico<br/>aggregate + outbox"]
            RegularCommand --> RegularAggregate --> RegularOutbox --> RegularCommit
        end

        subgraph WebhookFlow["Webhook HMAC válido"]
            direction TB
            Webhook["ReceiveEstimateDecisionCommand"]
            Inbox["Registra inbox<br/>eventId + payloadHash"]
            NewEvent{"Evento novo?"}
            WebhookAggregate["Altera WorkOrder<br/>e gera eventos"]
            WebhookOutbox["Grava mensagens<br/>de outbox"]
            WebhookCommit["Commit atômico<br/>aggregate + inbox + outbox"]
            Replay["Mesmo hash: replay sem efeito<br/>hash diferente: conflito"]
            Webhook --> Inbox --> NewEvent
            NewEvent -->|"sim"| WebhookAggregate --> WebhookOutbox --> WebhookCommit
            NewEvent -->|"não"| Replay
        end
    end

    subgraph Publisher["IntegrationOutboxPublisher — entrega assíncrona"]
        direction TB
        Poll["Polling em lote"]
        Lease["Claim com leaseId + leaseExpiresAt<br/>FOR UPDATE SKIP LOCKED"]
        Publish["Valida payload e publica no SNS"]
        Outcome{"Publicação aceita?"}
        Mark["UPDATE condicional MarkProcessed<br/>Id + LeaseId + ProcessedAt nulo"]
        Reschedule["UPDATE condicional Reschedule<br/>Id + LeaseId + ProcessedAt nulo<br/>backoff limitado"]
        Updated{"Uma linha atualizada?"}
        Processed["Processed<br/>marca ProcessedAt"]
        Retried["Rescheduled<br/>define NextAttemptAt"]
        OwnershipLost["OwnershipLost<br/>não sobrescreve outro worker"]

        Poll --> Lease --> Publish --> Outcome
        Outcome -->|"sim"| Mark --> Updated
        Outcome -->|"não / exceção"| Reschedule --> Updated
        Updated -->|"Mark: sim"| Processed
        Updated -->|"Reschedule: sim"| Retried -->|"após o prazo"| Poll
        Updated -->|"não"| OwnershipLost
    end

    SNS["Amazon SNS<br/>entrega eventual; duplicata possível"]
    Email["Assinatura de e-mail confirmada"]

    RegularCommit --> Poll
    WebhookCommit --> Poll
    Publish -->|"request aceito"| SNS --> Email

    classDef transaction fill:#eff6ff,stroke:#1d4ed8,color:#111827;
    classDef async fill:#fef3c7,stroke:#a16207,color:#111827;
    classDef success fill:#ecfdf5,stroke:#047857,color:#111827;
    classDef retry fill:#fef2f2,stroke:#b91c1c,color:#111827;
    class RegularCommand,RegularAggregate,RegularOutbox,RegularCommit,Webhook,Inbox,WebhookAggregate,WebhookOutbox,WebhookCommit transaction;
    class Poll,Lease,Publish,Outcome,Mark,Reschedule,Updated async;
    class Processed,SNS,Email success;
    class Retried,OwnershipLost,Replay retry;
