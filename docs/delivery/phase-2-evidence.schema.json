{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GarageFlow Phase 2 evidence",
  "description": "Strict, non-secret contract for live and finalized Phase 2 delivery evidence.",
  "oneOf": [
    {
      "$ref": "#/$defs/liveEvidence"
    },
    {
      "$ref": "#/$defs/finalEvidence"
    }
  ],
  "$defs": {
    "safePropertyName": {
      "type": "string",
      "not": {
        "pattern": "([Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Pp][Ww][Dd]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Oo][Nn][Nn][Ee][Cc][Tt][Ii][Oo][Nn][Ss][Tt][Rr][Ii][Nn][Gg]|[Aa][Pp][Ii][Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][Kk][Ee][Yy]|[Ss][Ee][Ss][Ss][Ii][Oo][Nn][Tt][Oo][Kk][Ee][Nn]|[Hh][Mm][Aa][Cc][Kk][Ee][Yy]|[Jj][Ww][Tt][Kk][Ee][Yy]|[Rr][Aa][Ww][Ll][Oo][Gg]|[Ss][Tt][Aa][Tt][Ee]|[Pp][Ll][Aa][Nn]|[Tt][Ee][Rr][Rr][Aa][Ff][Oo][Rr][Mm](?:[Ss][Tt][Aa][Tt][Ee]|[Pp][Ll][Aa][Nn]))"
      }
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,7})?Z$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repositoryUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$",
      "maxLength": 300
    },
    "workflowRunUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]*$",
      "maxLength": 400
    },
    "secureUrl": {
      "type": "string",
      "pattern": "^https://[^\\s/?#@]+(?:[/?#][^\\s]*)?$",
      "maxLength": 500
    },
    "publicApiUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s/?#@]+(?::[1-9][0-9]{0,4})?(?:/[^\\s]*)?$",
      "maxLength": 400
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "nameWithOwner",
        "url",
        "commitSha"
      ],
      "properties": {
        "nameWithOwner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 200
        },
        "url": {
          "$ref": "#/$defs/repositoryUrl"
        },
        "commitSha": {
          "$ref": "#/$defs/commitSha"
        }
      }
    },
    "workflowRun": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "workflowName",
        "runId",
        "url",
        "headSha",
        "status",
        "conclusion",
        "startedAtUtc",
        "completedAtUtc"
      ],
      "properties": {
        "workflowName": {
          "enum": [
            "Deploy AWS Academy",
            "Quality Gate",
            "Destroy AWS Academy"
          ]
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "$ref": "#/$defs/workflowRunUrl"
        },
        "headSha": {
          "$ref": "#/$defs/commitSha"
        },
        "status": {
          "const": "completed"
        },
        "conclusion": {
          "const": "success"
        },
        "startedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "completedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "baseUrl"
      ],
      "properties": {
        "baseUrl": {
          "$ref": "#/$defs/publicApiUrl"
        }
      }
    },
    "eks": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "clusterName",
        "status",
        "version",
        "nodeGroupName",
        "nodeGroupStatus"
      ],
      "properties": {
        "clusterName": {
          "const": "garageflow-academy"
        },
        "status": {
          "const": "ACTIVE"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "nodeGroupName": {
          "const": "garageflow-academy-workers"
        },
        "nodeGroupStatus": {
          "const": "ACTIVE"
        }
      }
    },
    "rds": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "identifier",
        "status",
        "engine",
        "publiclyAccessible"
      ],
      "properties": {
        "identifier": {
          "const": "garageflow-academy"
        },
        "status": {
          "const": "available"
        },
        "engine": {
          "const": "postgres"
        },
        "publiclyAccessible": {
          "const": false
        }
      }
    },
    "ecr": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "repositoryName",
        "imageTag",
        "imageDigest"
      ],
      "properties": {
        "repositoryName": {
          "const": "garageflow"
        },
        "imageTag": {
          "$ref": "#/$defs/commitSha"
        },
        "imageDigest": {
          "$ref": "#/$defs/imageDigest"
        }
      }
    },
    "sns": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "topicName",
        "status",
        "confirmedEmailSubscriptions",
        "notificationObservedAtUtc"
      ],
      "properties": {
        "topicName": {
          "const": "garageflow-work-orders"
        },
        "status": {
          "const": "confirmed-and-received"
        },
        "confirmedEmailSubscriptions": {
          "type": "integer",
          "minimum": 1
        },
        "notificationObservedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "region",
        "eks",
        "rds",
        "ecr",
        "sns"
      ],
      "properties": {
        "region": {
          "const": "us-east-1"
        },
        "eks": {
          "$ref": "#/$defs/eks"
        },
        "rds": {
          "$ref": "#/$defs/rds"
        },
        "ecr": {
          "$ref": "#/$defs/ecr"
        },
        "sns": {
          "$ref": "#/$defs/sns"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "const": "garageflow-api"
        },
        "type": {
          "const": "LoadBalancer"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "name",
        "desiredReplicas",
        "readyReplicas",
        "availableReplicas"
      ],
      "properties": {
        "name": {
          "const": "garageflow-api"
        },
        "desiredReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "readyReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "availableReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        }
      }
    },
    "pod": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "name",
        "phase",
        "ready",
        "restartCount",
        "imageDigest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^garageflow-api-[a-z0-9-]+$",
          "maxLength": 253
        },
        "phase": {
          "const": "Running"
        },
        "ready": {
          "const": true
        },
        "restartCount": {
          "type": "integer",
          "minimum": 0
        },
        "imageDigest": {
          "$ref": "#/$defs/imageDigest"
        }
      }
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "name",
        "minimumReplicas",
        "maximumReplicas",
        "currentReplicas",
        "desiredReplicas",
        "cpuTargetPercent",
        "memoryTargetPercent"
      ],
      "properties": {
        "name": {
          "const": "garageflow-api"
        },
        "minimumReplicas": {
          "const": 2
        },
        "maximumReplicas": {
          "const": 6
        },
        "currentReplicas": {
          "const": 2
        },
        "desiredReplicas": {
          "const": 2
        },
        "cpuTargetPercent": {
          "const": 60
        },
        "memoryTargetPercent": {
          "const": 70
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "namespace",
        "service",
        "deployment",
        "pods",
        "hpa"
      ],
      "properties": {
        "namespace": {
          "const": "garageflow"
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "pods": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pod"
          }
        },
        "hpa": {
          "$ref": "#/$defs/hpa"
        }
      }
    },
    "replicaObservation": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "observedAtUtc",
        "readyReplicas"
      ],
      "properties": {
        "observedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "readyReplicas": {
          "const": 2
        }
      }
    },
    "peakObservation": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "observedAtUtc",
        "maximumReplicasObserved"
      ],
      "properties": {
        "observedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "maximumReplicasObserved": {
          "type": "integer",
          "minimum": 3,
          "maximum": 6
        }
      }
    },
    "k6": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "httpReqFailedRate",
        "httpReqDurationP95Ms"
      ],
      "properties": {
        "httpReqFailedRate": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.02
        },
        "httpReqDurationP95Ms": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1000
        }
      }
    },
    "hpaDemonstration": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "status",
        "baseline",
        "peak",
        "recovery",
        "k6"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "baseline": {
          "$ref": "#/$defs/replicaObservation"
        },
        "peak": {
          "$ref": "#/$defs/peakObservation"
        },
        "recovery": {
          "$ref": "#/$defs/replicaObservation"
        },
        "k6": {
          "$ref": "#/$defs/k6"
        }
      }
    },
    "liveEvidence": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "schemaVersion",
        "evidenceType",
        "capturedAtUtc",
        "repository",
        "deployRun",
        "api",
        "aws",
        "kubernetes",
        "hpaDemonstration"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidenceType": {
          "const": "live"
        },
        "capturedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "deployRun": {
          "$ref": "#/$defs/workflowRun"
        },
        "api": {
          "$ref": "#/$defs/api"
        },
        "aws": {
          "$ref": "#/$defs/aws"
        },
        "kubernetes": {
          "$ref": "#/$defs/kubernetes"
        },
        "hpaDemonstration": {
          "$ref": "#/$defs/hpaDemonstration"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "name",
        "identifier"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/boundedText"
        },
        "identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{2,80}$"
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "url",
        "visibility",
        "durationSeconds",
        "anonymousPlaybackVerified",
        "verifiedAtUtc"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/secureUrl"
        },
        "visibility": {
          "enum": [
            "public",
            "unlisted"
          ]
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "anonymousPlaybackVerified": {
          "const": true
        },
        "verifiedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "destroyChecks": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "eksClusterAbsent",
        "nodeGroupAbsent",
        "runningEc2WorkersAbsent",
        "rdsAbsent",
        "ecrAbsent",
        "snsAbsent",
        "configurationEntriesAbsent",
        "loadBalancerAbsent",
        "vpcAbsent"
      ],
      "properties": {
        "eksClusterAbsent": {
          "const": true
        },
        "nodeGroupAbsent": {
          "const": true
        },
        "runningEc2WorkersAbsent": {
          "const": true
        },
        "rdsAbsent": {
          "const": true
        },
        "ecrAbsent": {
          "const": true
        },
        "snsAbsent": {
          "const": true
        },
        "configurationEntriesAbsent": {
          "const": true
        },
        "loadBalancerAbsent": {
          "const": true
        },
        "vpcAbsent": {
          "const": true
        }
      }
    },
    "destroy": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "status",
        "run",
        "verifiedAtUtc",
        "checks"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "run": {
          "$ref": "#/$defs/workflowRun"
        },
        "verifiedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "checks": {
          "$ref": "#/$defs/destroyChecks"
        }
      }
    },
    "retainedBackendBucket": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "status",
        "accessible",
        "versioningStatus",
        "publicAccessBlocked",
        "encryption",
        "verifiedAtUtc"
      ],
      "properties": {
        "status": {
          "const": "retained-private-versioned"
        },
        "accessible": {
          "const": true
        },
        "versioningStatus": {
          "const": "Enabled"
        },
        "publicAccessBlocked": {
          "const": true
        },
        "encryption": {
          "enum": [
            "AES256",
            "aws:kms"
          ]
        },
        "verifiedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "finalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "$ref": "#/$defs/safePropertyName"
      },
      "required": [
        "schemaVersion",
        "evidenceType",
        "finalizedAtUtc",
        "group",
        "participants",
        "video",
        "liveEvidence",
        "qualityGateRun",
        "destroy",
        "retainedBackendBucket"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidenceType": {
          "const": "final"
        },
        "finalizedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "group": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "#/$defs/safePropertyName"
          },
          "required": [
            "identifier"
          ],
          "properties": {
            "identifier": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{2,80}$"
            }
          }
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "video": {
          "$ref": "#/$defs/video"
        },
        "liveEvidence": {
          "$ref": "#/$defs/liveEvidence"
        },
        "qualityGateRun": {
          "$ref": "#/$defs/workflowRun"
        },
        "destroy": {
          "$ref": "#/$defs/destroy"
        },
        "retainedBackendBucket": {
          "$ref": "#/$defs/retainedBackendBucket"
        }
      }
    }
  }
}
