{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GarageFlow Execution messages v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "messageType",
    "messageId",
    "correlationId",
    "occurredAt",
    "workOrderId",
    "estimateId",
    "executionId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "messageType": {
      "enum": [
        "execution.schedule.v1",
        "execution.scheduled.v1",
        "execution.schedule-rejected.v1",
        "execution.started.v1",
        "execution.completed.v1",
        "execution.start.v1",
        "execution.complete.v1"
      ]
    },
    "messageId": {
      "$ref": "#/$defs/id"
    },
    "correlationId": {
      "$ref": "#/$defs/id"
    },
    "workOrderId": {
      "$ref": "#/$defs/id"
    },
    "estimateId": {
      "$ref": "#/$defs/id"
    },
    "executionId": {
      "$ref": "#/$defs/id"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,7})?(Z|[+-](0[0-9]|1[0-4]):[0-5][0-9])$"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "execution.schedule.v1"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/schedule"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "execution.schedule-rejected.v1"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/rejected"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "enum": [
              "execution.scheduled.v1",
              "execution.started.v1",
              "execution.completed.v1",
              "execution.start.v1",
              "execution.complete.v1"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "maxProperties": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "schedule": {
      "type": "object",
      "required": [
        "serviceLineIds"
      ],
      "additionalProperties": false,
      "properties": {
        "serviceLineIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        }
      }
    },
    "rejected": {
      "type": "object",
      "required": [
        "reasonCode"
      ],
      "additionalProperties": false,
      "properties": {
        "reasonCode": {
          "const": "work_order_already_scheduled"
        }
      }
    }
  }
}
