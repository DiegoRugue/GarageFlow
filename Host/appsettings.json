{
  "Database": {
    "Provider": "Postgres",
    "AutoMigrate": true,
    "AutoSeed": false,
    "SeedScriptPath": "scripts/seed-local.sql"
  },
  "ConnectionStrings": {
    "GarageFlow": "__SET_ME_GARAGEFLOW_CONNECTION_STRING__"
  },
  "Auth": {
    "Internal": {
      "Enabled": false
    },
    "Jwt": {
      "Issuer": "GarageFlow",
      "Audience": "GarageFlow.Adapters.Api",
      "Key": "__SET_ME_JWT_KEY__",
      "ExpiresMinutes": 120
    },
    "BootstrapAdmin": {
      "FullName": "System Admin",
      "Email": "admin@garageflow.local",
      "BirthDate": "1990-01-01",
      "Password": "__SET_ME_BOOTSTRAP_ADMIN_PASSWORD__"
    }
  },
  "Webhooks": {
    "EstimateDecisions": {
      "HmacSecret": "__SET_ME_ESTIMATE_DECISION_WEBHOOK_SECRET__"
    }
  },
  "Integrations": {
    "Outbox": {
      "Enabled": false,
      "BatchSize": 10,
      "PollingIntervalSeconds": 5,
      "LeaseDurationSeconds": 300,
      "InitialRetryDelaySeconds": 5,
      "MaxRetryDelaySeconds": 300
    },
    "Sns": {
      "Region": "us-east-1",
      "TopicArn": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
