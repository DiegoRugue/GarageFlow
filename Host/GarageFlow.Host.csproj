<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Adapters.Api\GarageFlow.Adapters.Api.csproj" />
    <ProjectReference Include="..\Adapters.Infrastructure\GarageFlow.Adapters.Infrastructure.csproj" />
    <ProjectReference Include="..\Application\GarageFlow.Application.csproj" />
    <ProjectReference Include="..\SharedKernel\GarageFlow.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- DomainEventNotification intentionally permits zero handlers; Mediator's object Publish contract drops it until an application handler exists. -->
    <NoWarn>$(NoWarn);MSG0005</NoWarn>
  </PropertyGroup>

</Project>
